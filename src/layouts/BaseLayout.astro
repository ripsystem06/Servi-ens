---
import Navbar from '@/components/Navbar.astro';
import Footer from '@/components/Footer.astro';
import '@/styles/global.css';

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Catálogo Ensenada — Directorio de Servicios Locales',
  description = 'Descubrí los mejores restaurantes, hoteles, electricistas, plomeros, talleres mecánicos, salones de eventos, tiendas y servicios profesionales de Ensenada y sus alrededores.',
} = Astro.props;
---
<!doctype html>
<html lang="es" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="font-sans text-on-surface bg-background antialiased overflow-x-hidden">
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
