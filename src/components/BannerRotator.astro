---

<div class="space-y-6">
  <p class="font-sans text-label-sm text-on-surface-variant/50 uppercase tracking-widest text-center">Espacio Publicitario</p>
  <a
    href="/publicidad"
    class="block relative rounded-xl overflow-hidden shadow-md hover:shadow-lg transition-all duration-300 group"
  >
    <img
      src="/banners/verticales/promo.svg"
      alt="Promociona tu negocio aquí, contáctanos"
      class="w-full h-auto object-cover"
    />
    <!-- Hover overlay -->
    <div class="absolute inset-0 bg-black/0 group-hover:bg-black/5 transition-colors duration-300" />
  </a>
</div>
