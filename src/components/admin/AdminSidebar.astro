---
const { currentPath = '/' } = Astro.props as { currentPath?: string };

const links = [
  { label: 'Dashboard', href: '/admin', icon: 'layout-dashboard' },
  { label: 'Negocios', href: '/admin/negocios', icon: 'building-2' },
  { label: 'Banners', href: '/admin/banners', icon: 'megaphone' },
];

function isActive(href: string): boolean {
  if (href === '/admin') return currentPath === '/admin';
  return currentPath.startsWith(href);
}
---

<aside
  id="admin-sidebar"
  class="fixed inset-y-0 left-0 z-40 w-60 bg-primary text-white flex flex-col transition-transform duration-300 -translate-x-full lg:translate-x-0"
>
  <!-- Brand -->
  <div class="flex items-center gap-3 px-6 h-16 border-b border-primary-container">
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
    <span class="font-headline font-bold text-headline-md">Catálogo</span>
  </div>

  <!-- Nav Links -->
  <nav class="flex-1 py-4 space-y-1 px-3">
    {links.map((link) => (
      <a
        href={link.href}
        class={`flex items-center gap-3 px-3 py-2.5 rounded-md text-label-md transition-colors ${
          isActive(link.href)
            ? 'bg-primary-container text-white font-semibold'
            : 'text-primary-on-container hover:bg-primary-container/50 hover:text-white'
        }`}
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0">
          {link.icon === 'layout-dashboard' && <><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></>}
          {link.icon === 'building-2' && <><path d="M10 9h4"/><path d="M12 7v4"/><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/></>}
          {link.icon === 'megaphone' && <><path d="m3 11 18-5v12L3 14v-3z"/><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"/></>}
        </svg>
        {link.label}
      </a>
    ))}
  </nav>

  <!-- Logout -->
  <div class="px-3 pb-6 border-t border-primary-container">
    <form action="/api/auth/logout" method="POST" class="mt-4">
      <button
        type="submit"
        class="flex items-center gap-3 px-3 py-2.5 w-full rounded-md text-label-md text-primary-on-container hover:bg-primary-container/50 hover:text-white transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" x2="9" y1="12" y2="12"/></svg>
        Cerrar sesión
      </button>
    </form>
  </div>
</aside>
