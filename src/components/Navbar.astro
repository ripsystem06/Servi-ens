---
import { getZones, getSiteConfig } from '@/lib/data-loader';

const zones = getZones();
const site = getSiteConfig();
---

<nav
  id="navbar"
  class="fixed top-0 inset-x-0 z-50 transition-all duration-300"
>
  <div class="glass border-b border-border/60">
    <div class="flex justify-between items-center w-full max-w-container mx-auto h-[68px] px-gutter">
      <!-- Logo -->
      <a href="/" class="flex items-center shrink-0">
        <img
          src="/SERVIENS/logo-navbar.svg"
          alt={site.name}
          class="h-[28px] sm:h-[34px] w-auto"
          width="150"
          height="34"
        />
      </a>

      <!-- Desktop Links -->
      <div class="hidden lg:flex items-center gap-1">
        <a href="/" class="px-3 py-2 text-label-md font-medium text-secondary-600 hover:text-secondary-900 rounded-xl hover:bg-secondary-50 transition-colors">
          Inicio
        </a>

        <!-- Zonas dropdown -->
        <div class="relative group">
          <button class="px-3 py-2 text-label-md font-medium text-secondary-600 hover:text-secondary-900 rounded-xl hover:bg-secondary-50 transition-colors inline-flex items-center gap-1">
            Zonas
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <div class="absolute top-full left-0 mt-2 w-56 bg-white rounded-xl shadow-lg border border-border opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
            <div class="py-2">
              {zones.map((z) => (
                <a href={`/zona/${z.slug}`} class="block px-4 py-2.5 text-label-md text-secondary-600 hover:text-secondary-900 hover:bg-secondary-50 transition-colors">
                  {z.name}
                </a>
              ))}
            </div>
          </div>
        </div>

        <a href="/registro" class="ml-3 btn-primary btn-sm text-label-md">
          Registra tu servicio
        </a>
      </div>

      <!-- Mobile: hamburger + CTA -->
      <div class="flex lg:hidden items-center gap-2">
        <a href="/registro" class="btn-primary btn-sm text-label-sm whitespace-nowrap">
          <span class="hidden xs:inline">Registra tu servicio</span>
          <span class="xs:hidden">Registrar</span>
        </a>
        <button id="mobile-menu-toggle" class="p-2 -mr-2 rounded-xl hover:bg-secondary-50 transition-colors" aria-label="Abrir menú">
          <svg id="menu-icon-open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
          <svg id="menu-icon-close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="hidden"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden lg:hidden bg-white border-b border-border shadow-lg">
    <div class="px-gutter py-4 space-y-1">
      <a href="/" class="block px-3 py-2.5 rounded-xl text-label-md font-medium text-secondary-600 hover:text-secondary-900 hover:bg-secondary-50 transition-colors">Inicio</a>
      <p class="px-3 py-2 text-label-sm font-semibold text-muted uppercase tracking-wider">Zonas</p>
      {zones.map((z) => (
        <a href={`/zona/${z.slug}`} class="block px-3 py-2.5 rounded-xl text-label-md text-secondary-600 hover:text-secondary-900 hover:bg-secondary-50 transition-colors">{z.name}</a>
      ))}
    </div>
  </div>
</nav>

<!-- Spacer for fixed navbar -->
<div class="h-[68px]"></div>

<script>
  const navbar = document.getElementById('navbar');
  const navInner = navbar?.querySelector('.glass');
  let lastScroll = 0;
  let hidden = false;

  window.addEventListener('scroll', () => {
    const scrollY = window.scrollY;
    if (scrollY > 100 && scrollY > lastScroll && !hidden) {
      navbar!.style.transform = 'translateY(-100%)';
      hidden = true;
    } else if (scrollY < lastScroll && hidden) {
      navbar!.style.transform = 'translateY(0)';
      hidden = false;
    }
    if (scrollY <= 0) {
      navbar!.style.transform = 'translateY(0)';
      hidden = false;
    }
    lastScroll = scrollY;
  }, { passive: true });

  // Mobile toggle
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');
  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    if (isOpen) {
      menu?.classList.add('hidden');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    } else {
      menu?.classList.remove('hidden');
      iconOpen?.classList.add('hidden');
      iconClose?.classList.remove('hidden');
    }
  });
</script>
