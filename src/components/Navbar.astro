---
import { NAV_LINKS } from '@/lib/constants';
import { getZones } from '@/lib/data-loader';

const zones = getZones();
---

<nav
  id="navbar"
  class="sticky top-0 z-50 bg-surface border-b border-outline-variant transition-all duration-300"
>
  <div class="flex justify-between items-center w-full px-gutter max-w-container mx-auto h-20 lg:h-20">
    <!-- Logo -->
    <div class="flex items-center gap-10">
      <a
        href="/"
        class="font-headline font-bold text-headline-md text-primary hover:text-secondary transition-colors"
      >
        Catálogo Ensenada
      </a>

      <!-- Desktop Links -->
      <div class="hidden lg:flex items-center space-x-6">
        <a
          href="/"
          class="text-label-md font-semibold text-on-surface-variant hover:text-secondary transition-colors duration-200"
        >
          Inicio
        </a>
        <div class="relative group">
          <button
            class="text-label-md font-semibold text-on-surface-variant hover:text-secondary transition-colors duration-200 inline-flex items-center gap-1"
          >
            Zonas
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <div
            class="absolute top-full left-0 mt-2 w-60 bg-surface-container-lowest rounded-md shadow-coastal border border-outline-card opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50"
          >
            <div class="py-2">
              {zones.map((z) => (
                <a
                  href={`/zona/${z.slug}`}
                  class="block px-4 py-2.5 text-label-md text-on-surface hover:bg-surface-container-low hover:text-secondary transition-colors"
                >
                  {z.name}
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Search Form (desktop) -->
    <div class="hidden md:flex items-center gap-6">
      <div class="relative w-64 lg:w-72">
        <form action="/buscar" method="GET" class="w-full">
          <input
            type="text"
            name="q"
            placeholder="Buscar servicios..."
            class="w-full bg-surface-container-low border border-outline-variant rounded-full px-4 py-2 pl-10 text-body-md focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all"
          />
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant pointer-events-none"
          >
            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
          </svg>
        </form>
      </div>
    </div>

    <!-- Mobile Menu Toggle -->
    <button
      id="mobile-menu-toggle"
      class="lg:hidden p-2 rounded hover:bg-surface-container-low transition-colors"
      aria-label="Abrir menú"
    >
      <svg
        id="menu-icon-open"
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
      <svg
        id="menu-icon-close"
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="hidden"
      >
        <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
      </svg>
    </button>
  </div>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="hidden lg:hidden border-t border-outline-variant bg-surface"
  >
    <div class="px-gutter py-4 space-y-4">
      <!-- Mobile Search -->
      <form action="/buscar" method="GET">
        <div class="relative">
          <input
            type="text"
            name="q"
            placeholder="Buscar servicios..."
            class="w-full bg-surface-container-low border border-outline-variant rounded-full px-4 py-2 pl-10 text-body-md focus:ring-2 focus:ring-primary focus:border-transparent outline-none"
          />
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant pointer-events-none"
          >
            <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
          </svg>
        </div>
      </form>

      <a href="/" class="block py-2 text-label-md font-semibold text-on-surface hover:text-secondary">
        Inicio
      </a>
    </div>
  </div>
</nav>

<script>
  // Scroll shrink effect
  const navbar = document.getElementById('navbar');
  function updateNavbar() {
    const scrollY = window.scrollY;
    if (scrollY > 50) {
      navbar?.classList.add('glass-effect', 'shadow-coastal');
      const inner = navbar?.querySelector('.h-20');
      if (inner) {
        inner.classList.remove('lg\\:h-20');
        inner.classList.add('h-16');
      }
    } else {
      navbar?.classList.remove('glass-effect', 'shadow-coastal');
      const inner = navbar?.querySelector('.h-16');
      if (inner) {
        inner.classList.remove('h-16');
        inner.classList.add('h-20');
      }
    }
  }

  window.addEventListener('scroll', updateNavbar, { passive: true });

  // Mobile menu toggle
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    if (isOpen) {
      menu?.classList.add('hidden');
      iconOpen?.classList.remove('hidden');
      iconClose?.classList.add('hidden');
    } else {
      menu?.classList.remove('hidden');
      iconOpen?.classList.add('hidden');
      iconClose?.classList.remove('hidden');
    }
  });
</script>
