---
import { getCategories } from '@/lib/data-loader';

const categories = getCategories();
const categorySlugs = categories.map(c => c.slug);
---

<section class="relative overflow-hidden bg-white">
  <!-- Background shapes -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden">
    <div class="absolute -top-40 -right-40 w-[600px] h-[600px] rounded-full bg-primary/5 blur-3xl"></div>
    <div class="absolute -bottom-20 -left-20 w-[400px] h-[400px] rounded-full bg-primary-300/10 blur-3xl"></div>
    <div class="absolute top-1/4 left-1/3 w-2 h-2 rounded-full bg-primary/20 animate-float" style="animation-delay: 0s"></div>
    <div class="absolute top-1/3 right-1/4 w-3 h-3 rounded-full bg-primary/15 animate-float" style="animation-delay: 2s"></div>
    <div class="absolute bottom-1/3 left-1/4 w-2 h-2 rounded-full bg-primary-400/20 animate-float" style="animation-delay: 4s"></div>
    <div class="absolute inset-0 bg-grid opacity-30"></div>
  </div>

  <div class="relative max-w-container mx-auto px-gutter py-20 lg:py-28">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Left: Text + CTA -->
      <div class="space-y-8 animate-fade-up">
        <h1 class="font-display text-display-xl lg:text-display-lg xl:text-display-xl text-secondary-900 tracking-tight text-balance leading-[1.1]">
          Necesitas un servicio,
          <span class="text-primary">aquí lo encuentras.</span>
        </h1>

        <p class="text-body-lg text-muted max-w-xl text-balance">
          Encuentra profesionales confiables para cualquier necesidad.
          Desde plomería hasta asesoría legal, todo en un solo lugar.
        </p>

        <!-- Search Bar -->
        <form id="hero-search" action="/buscar" method="GET" class="flex gap-3 max-w-lg">
          <div class="flex-1 relative">
            <svg
              width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
              stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
              class="absolute left-5 top-1/2 -translate-y-1/2 text-muted pointer-events-none"
            >
              <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
            </svg>
            <input
              type="text" name="q" id="hero-search-input"
              placeholder="¿Qué servicio estás buscando?"
              class="input-lg pl-12 pr-4"
              autocomplete="off"
            />
          </div>
          <button type="submit" class="btn-primary btn-lg shrink-0">
            Buscar
          </button>
        </form>

        <!-- CTAs -->
        <div class="flex flex-wrap gap-3 pt-2">
          <a href="/buscar" class="btn-primary">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
            Buscar servicio
          </a>
          <a href="/registro" class="btn-secondary">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>
            Registrar mi negocio
          </a>
        </div>


      </div>

      <!-- Right: Abstract illustration -->
      <div class="hidden lg:flex items-center justify-center animate-scale-in">
        <div class="relative w-full max-w-[480px] aspect-square">
          <!-- Map grid -->
          <div class="absolute inset-0 bg-grid rounded-2xl opacity-50"></div>
          <!-- Central pin -->
          <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2">
            <div class="w-20 h-20 rounded-2xl bg-primary shadow-glow flex items-center justify-center">
              <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2C8.13 2 5 5.13 5 9c0 3.87 5.07 10.08 6.35 11.65.35.43.95.43 1.3 0C13.93 19.08 19 12.87 19 9c0-3.87-3.13-7-7-7z"/>
                <circle cx="12" cy="9" r="2"/>
              </svg>
            </div>
          </div>
          <!-- Connection lines -->
          <svg class="absolute inset-0 w-full h-full" viewBox="0 0 400 400" fill="none">
            <circle cx="200" cy="200" r="100" stroke="#2563EB" stroke-opacity="0.08" stroke-width="1" stroke-dasharray="4 6"/>
            <circle cx="200" cy="200" r="160" stroke="#2563EB" stroke-opacity="0.05" stroke-width="1" stroke-dasharray="4 6"/>
            <!-- Small dots -->
            <circle cx="120" cy="120" r="4" fill="#3B82F6" fill-opacity="0.3"/>
            <circle cx="280" cy="100" r="3" fill="#60A5FA" fill-opacity="0.25"/>
            <circle cx="300" cy="260" r="4" fill="#3B82F6" fill-opacity="0.3"/>
            <circle cx="100" cy="280" r="3" fill="#60A5FA" fill-opacity="0.25"/>
            <circle cx="160" cy="300" r="3" fill="#3B82F6" fill-opacity="0.2"/>
            <circle cx="310" cy="180" r="2" fill="#93C5FD" fill-opacity="0.3"/>
            <circle cx="90" cy="170" r="2" fill="#93C5FD" fill-opacity="0.3"/>
            <!-- Connection lines -->
            <line x1="120" y1="120" x2="200" y2="200" stroke="#3B82F6" stroke-opacity="0.08" stroke-width="1"/>
            <line x1="280" y1="100" x2="200" y2="200" stroke="#3B82F6" stroke-opacity="0.06" stroke-width="1"/>
            <line x1="300" y1="260" x2="200" y2="200" stroke="#3B82F6" stroke-opacity="0.08" stroke-width="1"/>
            <line x1="100" y1="280" x2="200" y2="200" stroke="#3B82F6" stroke-opacity="0.06" stroke-width="1"/>
            <!-- People icons at dots -->
            <circle cx="120" cy="110" r="8" fill="white" stroke="#3B82F6" stroke-opacity="0.2" stroke-width="1"/>
            <circle cx="280" cy="90" r="8" fill="white" stroke="#3B82F6" stroke-opacity="0.2" stroke-width="1"/>
            <circle cx="305" cy="270" r="8" fill="white" stroke="#3B82F6" stroke-opacity="0.2" stroke-width="1"/>
            <circle cx="95" cy="290" r="8" fill="white" stroke="#3B82F6" stroke-opacity="0.2" stroke-width="1"/>
          </svg>
        </div>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ categorySlugs }}>
  const form = document.getElementById('hero-search');
  const input = document.getElementById('hero-search-input');

  // Normalize accents: "plomería" → "plomeria"
  function stripAccents(str: string): string {
    return str.normalize('NFD').replace(/[\u0300-\u036f]/g, '');
  }

  form?.addEventListener('submit', (e) => {
    const q = stripAccents(input?.value.trim().toLowerCase() || '');
    if (!q) return;
    // Check if normalized query matches a normalized category slug
    const normalizedSlugs = categorySlugs.map(s => ({ original: s, normalized: stripAccents(s) }));
    const match = normalizedSlugs.find(s => s.normalized === q || s.normalized.includes(q) || q.includes(s.normalized));
    if (match) {
      e.preventDefault();
      window.location.href = '/' + match.original;
    }
    // Otherwise let the form submit normally to /buscar?q=...
  });
</script>
