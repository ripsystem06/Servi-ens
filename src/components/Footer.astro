---
import { getSiteConfig } from '@/lib/data-loader';

const site = getSiteConfig();
---

<footer class="bg-primary-container text-white mt-section">
  <div class="w-full py-section px-gutter max-w-container mx-auto text-center space-y-2">
    <p class="font-headline text-headline-md font-bold text-white">
      {site.name}
    </p>
    <p class="font-sans text-body-md text-white/80 max-w-md mx-auto">
      {site.tagline}
    </p>
    <div class="pt-6 mt-6 border-t border-white/20">
      <p class="font-sans text-label-sm text-white/60">
        &copy; {new Date().getFullYear()} {site.name}. Hecho en Ensenada, Baja California.
      </p>
      <p class="font-sans text-label-sm text-white/40 mt-1">
        por <a href="https://xant.online" class="hover:text-white transition-colors underline underline-offset-2">xant.online</a>
      </p>
    </div>
  </div>
</footer>
