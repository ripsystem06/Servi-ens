---
import { getSiteConfig } from '@/lib/data-loader';

const site = getSiteConfig();
---

<footer class="bg-white border-t border-border">
  <div class="max-w-container mx-auto px-gutter py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10">
      <!-- Brand -->
      <div class="md:col-span-2 space-y-4">
        <a href="/" class="flex items-center">
          <img
            src="/SERVIENS/logo-footer.svg"
            alt={site.name}
            class="h-[60px] w-auto"
            width="240"
            height="60"
          />
        </a>
        <p class="text-body-md text-muted max-w-sm">{site.tagline}</p>
      </div>

      <!-- Legal -->
      <div>
        <p class="text-label-sm font-semibold text-secondary-400 uppercase tracking-wider mb-4">Legal</p>
        <div class="space-y-3">
          <a href="/nosotros" class="block text-label-md text-secondary-600 hover:text-primary transition-colors">Sobre nosotros</a>
          <a href="/aviso-privacidad" class="block text-label-md text-secondary-600 hover:text-primary transition-colors">Aviso de privacidad</a>
          <a href="/terminos" class="block text-label-md text-secondary-600 hover:text-primary transition-colors">Términos y condiciones</a>
        </div>
      </div>

      <!-- Contact -->
      <div>
        <p class="text-label-sm font-semibold text-secondary-400 uppercase tracking-wider mb-4">Contacto</p>
        <div class="space-y-3">
          <a href={`mailto:${site.contact.email}`} class="block text-label-md text-secondary-600 hover:text-primary transition-colors">{site.contact.email}</a>
          <a href={`tel:${site.contact.phone}`} class="block text-label-md text-secondary-600 hover:text-primary transition-colors">{site.contact.phone}</a>
        </div>
      </div>
    </div>

    <!-- Bottom -->
    <div class="mt-12 pt-8 border-t border-border flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-label-sm text-muted">
        &copy; {new Date().getFullYear()} {site.name}. Hecho en Ensenada, Baja California.
      </p>
      <p class="text-label-sm text-muted">
        por <a href="https://xant.online" class="hover:text-primary transition-colors underline underline-offset-2">xant.online</a>
      </p>
    </div>
  </div>
</footer>
