  'umbrella': '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><path d="M22 12a10.06 10.06 1 0 0-20 0Z"/><path d="M12 12v8a2 2 0 0 0 4 0"/><path d="M12 2v1"/></svg>',
  'key': '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><path d="m15.5 7.5 2.3 2.3a1 1 0 0 0 1.4 0l2.1-2.1a1 1 0 0 0 0-1.4L19 4"/><path d="m21 2-9.6 9.6"/><circle cx="7.5" cy="15.5" r="5.5"/></svg>',
  'briefcase': '<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><path d="M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/><rect width="20" height="14" x="2" y="6" rx="2"/></svg>',
};
---

<aside class="space-y-6">
  <div class="bg-surface-container-low p-4 rounded-md coastal-shadow border border-outline-card">
    <h3 class="font-headline text-headline-md text-primary mb-4">Categorías</h3>
    <ul class="space-y-1">
      {categories.map((cat) => {
        const isActive = activeSlug === cat.slug;
        const iconSvg = iconSvgs[cat.icon] ?? '';
        return (
          <li>
            <a
              href={`/${cat.slug}`}
              class={`flex items-center gap-3 p-2.5 rounded transition-colors group ${
                isActive
                  ? 'bg-primary/10 text-primary font-semibold'
                  : 'hover:bg-surface-variant text-on-surface-variant hover:text-secondary'
              }`}
            >
              {iconSvg && (
                <span
                  class={`shrink-0 ${isActive ? 'text-primary' : 'text-on-surface-variant group-hover:text-secondary'}`}
                  set:html={iconSvg}
                />
              )}
              <span class="font-sans text-label-md">{cat.name}</span>
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</aside>
