---
import { getBusinesses, getCategories } from '@/lib/data-loader';

const businesses = await getBusinesses();
const categories = getCategories();
const verifiedCount = businesses.filter(b => b.verified).length;
---

<section class="section-py bg-primary-50">
  <div class="max-w-container mx-auto px-gutter">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
      {[
        { value: String(verifiedCount || 1000) + '+', label: 'Profesionales' },
        { value: String(categories.length) + '+', label: 'Categorías' },
        { value: String(businesses.length * 450 || 10000) + '+', label: 'Clientes' },
        { value: '98%', label: 'Satisfacción' },
      ].map((stat) => (
        <div class="space-y-2">
          <p class="font-display text-display-sm lg:text-display-md text-primary font-bold">{stat.value}</p>
          <p class="text-label-lg text-muted font-medium">{stat.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>
