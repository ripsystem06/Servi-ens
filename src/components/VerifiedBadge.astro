---
export interface Props {
  verified?: boolean;
}

const { verified = false } = Astro.props;
---

{verified && (
  <span
    class="chip-verified inline-flex items-center gap-1"
    aria-label="Negocio verificado"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M20 6 9 17l-5-5"/>
    </svg>
    <span>Verificado</span>
  </span>
)}
