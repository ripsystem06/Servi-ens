---
interface Props {
  businessSlug: string;
  error?: string | null;
  success?: boolean;
}

const { businessSlug, error, success } = Astro.props;
---

<div class="bg-surface-container-low border border-outline-card rounded-xl p-6">
  <h3 class="font-headline text-headline-sm text-on-surface mb-6">
    Dejanos tu opinión
  </h3>

  {success && (
    <div class="mb-6 p-4 rounded-lg bg-success-light text-success-dark text-label-md font-medium flex items-center gap-2">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
      </svg>
      ¡Gracias! Tu reseña fue publicada.
    </div>
  )}

  {error && (
    <div class="mb-6 p-4 rounded-lg bg-red-50 text-red-700 text-label-md font-medium">
      {error}
    </div>
  )}

  <form
    id="review-form"
    action="/api/review"
    method="POST"
    class="space-y-5"
  >
    <input type="hidden" name="business_slug" value={businessSlug} />
    <input type="hidden" name="rating" id="rating-input" value="0" />

    <!-- Stars -->
    <div>
      <label class="block text-label-sm font-medium text-on-surface mb-2">
        Calificación <span class="text-red-500">*</span>
      </label>
      <div id="star-rating" class="flex gap-1">
        {[1, 2, 3, 4, 5].map((n) => (
          <button
            type="button"
            data-value={n}
            class="star-btn text-2xl transition-colors duration-150 focus:outline-none"
            aria-label={`${n} estrella${n > 1 ? 's' : ''}`}
          >
            <svg
              width="32"
              height="32"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="star-icon transition-colors duration-150"
            >
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
            </svg>
          </button>
        ))}
      </div>
      <p id="rating-label" class="text-label-xs text-muted/60 mt-1 h-4"></p>
    </div>

    <!-- Name -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label for="author_name" class="block text-label-sm font-medium text-on-surface mb-1">
          Nombre <span class="text-red-500">*</span>
        </label>
        <input
          type="text"
          id="author_name"
          name="author_name"
          required
          minlength="2"
          maxlength="50"
          placeholder="Ej: Juan"
          class="w-full px-4 py-2.5 rounded-lg border border-outline-card bg-surface focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition text-body-md placeholder:text-muted/40"
        />
      </div>
      <div>
        <label for="author_surname" class="block text-label-sm font-medium text-on-surface mb-1">
          Apellido <span class="text-red-500">*</span>
        </label>
        <input
          type="text"
          id="author_surname"
          name="author_surname"
          required
          minlength="2"
          maxlength="50"
          placeholder="Ej: Pérez"
          class="w-full px-4 py-2.5 rounded-lg border border-outline-card bg-surface focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition text-body-md placeholder:text-muted/40"
        />
      </div>
    </div>

    <!-- Comment -->
    <div>
      <label for="comment" class="block text-label-sm font-medium text-on-surface mb-1">
        Tu comentario <span class="text-red-500">*</span>
        <span class="text-muted/50 font-normal">(máx. 150 caracteres)</span>
      </label>
      <textarea
        id="comment"
        name="comment"
        required
        maxlength="150"
        rows="3"
        placeholder="Compartí tu experiencia con este servicio..."
        class="w-full px-4 py-2.5 rounded-lg border border-outline-card bg-surface focus:border-primary focus:ring-2 focus:ring-primary/20 outline-none transition text-body-md placeholder:text-muted/40 resize-none"
      ></textarea>
      <div class="flex justify-between items-center mt-1">
        <span id="char-count" class="text-label-xs text-muted/50">0 / 150</span>
      </div>
    </div>

    <!-- Submit -->
    <button
      type="submit"
      class="w-full sm:w-auto bg-primary hover:brightness-110 text-white font-bold py-3 px-8 rounded-lg transition-all inline-flex items-center justify-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed"
      id="submit-btn"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m12 19-7-7 7-7"/><path d="M19 12H5"/>
      </svg>
      Enviar reseña
    </button>
  </form>
</div>

<script>
  const stars = document.querySelectorAll<HTMLButtonElement>('.star-btn');
  const ratingInput = document.getElementById('rating-input') as HTMLInputElement;
  const ratingLabel = document.getElementById('rating-label') as HTMLParagraphElement;
  const comment = document.getElementById('comment') as HTMLTextAreaElement;
  const charCount = document.getElementById('char-count') as HTMLSpanElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;

  const labels = ['', 'Muy malo', 'Malo', 'Regular', 'Bueno', 'Excelente'];
  let currentRating = 0;

  function updateStars(value: number) {
    stars.forEach((star, i) => {
      const n = i + 1;
      const icon = star.querySelector('.star-icon') as SVGElement;
      if (n <= value) {
        icon.setAttribute('fill', '#E76F51');
        icon.setAttribute('stroke', '#E76F51');
      } else {
        icon.setAttribute('fill', 'none');
        icon.setAttribute('stroke', 'currentColor');
      }
    });
    ratingInput.value = String(value);
    ratingLabel.textContent = value > 0 ? labels[value]! : '';
  }

  function validateForm(): boolean {
    return currentRating > 0;
  }

  stars.forEach((star) => {
    star.addEventListener('click', () => {
      currentRating = parseInt(star.dataset.value || '0');
      updateStars(currentRating);
    });

    star.addEventListener('mouseenter', () => {
      const value = parseInt(star.dataset.value || '0');
      updateStars(value);
    });

    star.addEventListener('mouseleave', () => {
      updateStars(currentRating);
    });
  });

  // Character counter
  comment.addEventListener('input', () => {
    const len = comment.value.length;
    charCount.textContent = `${len} / 150`;
  });

  // Prevent submit without rating
  const form = document.getElementById('review-form') as HTMLFormElement;
  form.addEventListener('submit', (e) => {
    if (!validateForm()) {
      e.preventDefault();
      ratingLabel.textContent = 'Seleccioná una calificación';
      ratingLabel.classList.add('text-red-500');
      ratingLabel.classList.remove('text-muted/60');
    }
  });
</script>

<style>
  .star-btn:hover .star-icon {
    transform: scale(1.15);
  }
</style>
