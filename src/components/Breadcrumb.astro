---
export interface BreadcrumbItem {
  label: string;
  href?: string;
}

export interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav class="flex items-center space-x-2 text-on-surface-variant font-sans text-label-md" aria-label="Breadcrumb">
  <a href="/" class="hover:text-secondary transition-colors">Inicio</a>

  {items.map((item, i) => {
    const isLast = i === items.length - 1;
    return (
      <>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="shrink-0"
          aria-hidden="true"
        >
          <path d="m9 18 6-6-6-6"/>
        </svg>

        {isLast || !item.href ? (
          <span class="text-on-surface font-semibold truncate">{item.label}</span>
        ) : (
          <a href={item.href} class="hover:text-secondary transition-colors truncate">
            {item.label}
          </a>
        )}
      </>
    );
  })}
</nav>
