---
import BaseLayout from '@/layouts/BaseLayout.astro';

const success = Astro.url.searchParams.get('success');
---

<BaseLayout
  title="Publicidad — Serv-Ens"
  description="Promociona tu negocio en el catálogo de servicios más completo de Ensenada."
>
  <div class="max-w-2xl mx-auto px-gutter py-section">
    <div class="text-center mb-10">
      <h1 class="font-headline text-headline-lg text-primary mb-3">Publicidad en Serv-Ens</h1>
      <p class="text-body-lg text-muted max-w-lg mx-auto">
        Llegá a miles de personas que buscan servicios en Ensenada. Completá el formulario y te contamos cómo promocionar tu negocio.
      </p>
    </div>

    <form action="/api/publicidad" method="POST" class="bg-surface-container-low border border-outline-card rounded-xl p-8 space-y-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label for="name" class="block text-label-md font-semibold text-on-surface mb-1.5">
            Nombre completo <span class="text-red-500">*</span>
          </label>
          <input type="text" id="name" name="name" required placeholder="Tu nombre"
            class="w-full bg-surface border border-outline-variant rounded-lg px-4 py-2.5 text-body-md focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all" />
        </div>
        <div>
          <label for="business" class="block text-label-md font-semibold text-on-surface mb-1.5">
            Negocio o servicio <span class="text-red-500">*</span>
          </label>
          <input type="text" id="business" name="business" required placeholder="Nombre de tu negocio"
            class="w-full bg-surface border border-outline-variant rounded-lg px-4 py-2.5 text-body-md focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all" />
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label for="email" class="block text-label-md font-semibold text-on-surface mb-1.5">
            Correo electrónico <span class="text-red-500">*</span>
          </label>
          <input type="email" id="email" name="email" required placeholder="contacto@tunegocio.com"
            class="w-full bg-surface border border-outline-variant rounded-lg px-4 py-2.5 text-body-md focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all" />
        </div>
        <div>
          <label for="phone" class="block text-label-md font-semibold text-on-surface mb-1.5">
            Teléfono <span class="text-red-500">*</span>
          </label>
          <input type="tel" id="phone" name="phone" required placeholder="+52 646 123 4567"
            class="w-full bg-surface border border-outline-variant rounded-lg px-4 py-2.5 text-body-md focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all" />
        </div>
      </div>

      <div>
        <label for="interest" class="block text-label-md font-semibold text-on-surface mb-1.5">
          ¿Qué tipo de publicidad te interesa? <span class="text-red-500">*</span>
        </label>
        <select id="interest" name="interest" required
          class="w-full bg-surface border border-outline-variant rounded-lg px-4 py-2.5 text-body-md focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all appearance-none">
          <option value="">Seleccioná una opción</option>
          <option value="banner-home">Banner en la página principal</option>
          <option value="banner-categoria">Banner en páginas de categoría</option>
          <option value="banner-lateral">Banner lateral (sidebar)</option>
          <option value="perfil-destacado">Perfil destacado en el catálogo</option>
          <option value="no-se">Todavía no lo sé — quiero más información</option>
        </select>
      </div>

      <div>
        <label for="message" class="block text-label-md font-semibold text-on-surface mb-1.5">
          Mensaje o comentarios adicionales
        </label>
        <textarea id="message" name="message" rows="3"
          placeholder="Contanos sobre tu negocio, presupuesto estimado, o cualquier duda que tengas..."
          class="w-full bg-surface border border-outline-variant rounded-lg px-4 py-2.5 text-body-md focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all resize-y"></textarea>
      </div>

      <button type="submit"
        class="w-full bg-primary text-white font-bold py-3 px-8 rounded-lg hover:bg-primary/90 transition-colors text-body-md">
        Enviar solicitud
      </button>

      <p class="text-label-sm text-muted/60 text-center">
        Tus datos solo se usarán para contactarte sobre opciones de publicidad. No compartimos tu información con terceros.
      </p>
    </form>
  </div>

  {success && (
    <div class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm p-4">
      <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full p-10 text-center" style="animation: fadeIn 0.3s ease-out">
        <div class="w-16 h-16 rounded-full bg-green-100 flex items-center justify-center mx-auto mb-6">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="m9 11 3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>
          </svg>
        </div>
        <h2 class="font-headline text-headline-md text-on-surface mb-3">¡Gracias por tu interés!</h2>
        <p class="text-body-md text-on-surface-variant mb-8 leading-relaxed">
          Recibimos tu solicitud de publicidad correctamente. Nos pondremos en contacto muy pronto para contarte las opciones disponibles y ayudarte a promocionar tu negocio en Ensenada.
        </p>
        <a href="/" class="inline-flex items-center gap-2 bg-primary hover:brightness-110 text-white font-bold py-3 px-8 rounded-lg transition-all">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>
          </svg>
          Ir al inicio
        </a>
        <div class="mt-4">
          <a href="/" class="text-label-md text-primary hover:underline">Volver a la página principal</a>
        </div>
      </div>
    </div>
  )}
</BaseLayout>
