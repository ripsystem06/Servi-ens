---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import CategoryChip from '@/components/CategoryChip.astro';
import VerifiedBadge from '@/components/VerifiedBadge.astro';
import BannerSlot from '@/components/BannerSlot.astro';
import {
  getBusinesses,
  getBusinessBySlug,
  getCategoryBySlug,
  getZoneBySlug,
} from '@/lib/data-loader';
import { SITE } from '@/lib/constants';
import type { ScheduleItem } from '@/lib/schemas';

export async function getStaticPaths() {
  const businesses = getBusinesses();
  return businesses.map((b) => ({
    params: { slug: b.slug },
  }));
}

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/404');
}

const business = getBusinessBySlug(slug);

// Invalid slug → 404
if (!business) {
  return Astro.redirect('/404');
}

const category = getCategoryBySlug(business.category);
const zone = getZoneBySlug(business.zone);

const pageTitle = `${business.name} — Catálogo Ensenada`;

// Open Graph image: first business photo or site default
const ogImage = business.photos?.[0]
  ? (business.photos[0].startsWith('http')
      ? business.photos[0]
      : `${SITE.url}${business.photos[0].startsWith('/') ? '' : '/'}${business.photos[0]}`)
  : undefined;

const pageDescription = business.description.length > 200
  ? business.description.slice(0, 197) + '...'
  : business.description;

const DAY_LABELS: Record<ScheduleItem['day'], string> = {
  mon: 'Lunes',
  tue: 'Martes',
  wed: 'Miércoles',
  thu: 'Jueves',
  fri: 'Viernes',
  sat: 'Sábado',
  sun: 'Domingo',
};

function formatPhone(phone: string): string {
  const digits = phone.replace(/\D/g, '');
  // If it starts with +52 but has no leading 1, format for WhatsApp (Mexico)
  const national = digits.startsWith('52') ? digits.slice(2) : digits;
  return national;
}
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ogImage={ogImage}
  canonicalUrl={`${SITE.url}/servicio/${business.slug}`}
>
  <div class="max-w-container mx-auto px-gutter py-section">
    <!-- Breadcrumb -->
    <div class="mb-8">
      <Breadcrumb
        items={[
          ...(category ? [{ label: category.name, href: `/${category.slug}` }] : []),
          { label: business.name },
        ]}
      />
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
      <!-- Left Column: Main Content -->
      <div class="lg:col-span-8 space-y-10">
        <!-- Business Header -->
        <section class="bg-surface-container-lowest p-6 md:p-8 rounded-md coastal-shadow border border-outline-card">
          <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
            <div class="space-y-3">
              <div class="flex flex-wrap items-center gap-3">
                <h1 class="font-headline text-headline-lg text-primary">
                  {business.name}
                </h1>
                <VerifiedBadge verified={business.verified} />
              </div>
              <div class="flex flex-wrap items-center gap-2">
                <CategoryChip category={business.category} />
                {zone && (
                  <span class="font-sans text-label-md text-on-surface-variant">
                    &bull; {zone.name}
                  </span>
                )}
              </div>
            </div>

            <!-- Contact buttons -->
            <div class="flex flex-wrap gap-3">
              {business.phone && (
                <a
                  href={`tel:${business.phone}`}
                  class="bg-accent text-white px-5 py-2.5 rounded-lg font-sans font-bold text-label-md inline-flex items-center gap-2 hover:brightness-110 transition-all"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                  </svg>
                  Llamar
                </a>
              )}
              {business.phone && (
                <a
                  href={`https://wa.me/52${formatPhone(business.phone)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="bg-[#25D366] text-white px-5 py-2.5 rounded-lg font-sans font-bold text-label-md inline-flex items-center gap-2 hover:brightness-105 transition-all"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" stroke="none">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.67-1.612-.918-2.207-.242-.579-.487-.5-.67-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
                  </svg>
                  WhatsApp
                </a>
              )}
              {business.email && (
                <a
                  href={`mailto:${business.email}`}
                  class="border-2 border-primary-container text-primary px-5 py-2.5 rounded-lg font-sans font-bold text-label-md inline-flex items-center gap-2 hover:bg-primary hover:text-on-primary transition-colors"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                  </svg>
                  Email
                </a>
              )}
              {business.website && (
                <a
                  href={business.website}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="border-2 border-primary-container text-primary px-5 py-2.5 rounded-lg font-sans font-bold text-label-md inline-flex items-center gap-2 hover:bg-primary hover:text-on-primary transition-colors"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                  </svg>
                  Sitio web
                </a>
              )}
            </div>
          </div>
        </section>

        <!-- Sobre nosotros -->
        <section class="space-y-4">
          <h2 class="font-headline text-headline-md text-primary">Sobre nosotros</h2>
          <p class="font-sans text-body-lg text-on-surface-variant leading-relaxed">
            {business.description}
          </p>
        </section>

        <!-- Servicios -->
        {business.services && business.services.length > 0 && (
          <section class="bg-surface-container-low p-6 md:p-8 rounded-md border border-outline-card">
            <h2 class="font-headline text-headline-md text-primary mb-6">Servicios</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-y-3 gap-x-8">
              {business.services.map((svc) => (
                <div class="flex items-center gap-3">
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#2A9D8F" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0">
                    <path d="M20 6 9 17l-5-5"/>
                  </svg>
                  <span class="font-sans text-body-md">{svc}</span>
                </div>
              ))}
            </div>
          </section>
        )}

        <!-- Galería -->
        {business.photos && business.photos.length > 0 && (
          <section class="space-y-4">
            <h2 class="font-headline text-headline-md text-primary">Galería</h2>
            <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
              {business.photos.map((photo, i) => (
                <div class={`aspect-square rounded-lg overflow-hidden border border-outline-card ${
                  i >= 3 && business.photos!.length > 4 ? 'hidden' : ''
                }`}>
                  <img
                    src={photo}
                    alt={`${business.name} — foto ${i + 1}`}
                    class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
                    loading="lazy"
                  />
                  {i === 3 && business.photos!.length > 4 && (
                    <div class="absolute inset-0 bg-primary/40 flex items-center justify-center">
                      <span class="text-white font-bold text-headline-md">
                        +{business.photos!.length - 3}
                      </span>
                    </div>
                  )}
                </div>
              ))}
            </div>
          </section>
        )}

        <!-- Horario -->
        {business.schedule && business.schedule.length > 0 && (
          <section class="bg-surface-container-lowest p-6 md:p-8 rounded-md border border-outline-card coastal-shadow">
            <h2 class="font-headline text-headline-md text-primary mb-6">Horario</h2>
            <div class="space-y-3">
              {business.schedule.map((item) => (
                <div class="flex justify-between items-center text-body-md">
                  <span class="text-on-surface-variant font-sans">
                    {DAY_LABELS[item.day] ?? item.day}
                  </span>
                  {item.closed ? (
                    <span class="font-sans font-bold text-error">Cerrado</span>
                  ) : (
                    <span class="font-sans font-bold">
                      {item.open} – {item.close}
                    </span>
                  )}
                </div>
              ))}
            </div>
          </section>
        )}

        <!-- Ubicación -->
        {(zone || business.address) && (
          <section class="space-y-4">
            <h2 class="font-headline text-headline-md text-primary">Ubicación</h2>
            <div class="bg-surface-container-lowest p-6 rounded-md border border-outline-card coastal-shadow">
              <div class="flex items-start gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#E76F51" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 mt-0.5">
                  <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>
                </svg>
                <div>
                  {zone && (
                    <p class="font-sans text-label-md font-semibold text-primary">{zone.name}</p>
                  )}
                  {business.address && (
                    <p class="font-sans text-body-md text-on-surface-variant mt-1">
                      {business.address}
                    </p>
                  )}
                </div>
              </div>
            </div>
          </section>
        )}
      </div>

      <!-- Right Sidebar: Banner Profile -->
      <aside class="lg:col-span-4 space-y-10">
        <BannerSlot slot="profile" category={business.category} />
      </aside>
    </div>
  </div>
</BaseLayout>
