---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import {
  getZones,
  getZoneBySlug,
  filterByZone,
} from '@/lib/data-loader';

export async function getStaticPaths() {
  const zones = getZones();
  return zones.map((z) => ({
    params: { zone: z.slug },
  }));
}

const { zone } = Astro.params;
const zoneData = getZoneBySlug(zone);

// Invalid zone slug → 404
if (!zoneData) {
  return Astro.redirect('/404');
}

const businesses = filterByZone(zone);
const pageTitle = `${zoneData.name} — Catálogo Ensenada`;
---

<BaseLayout title={pageTitle}>
  <div class="max-w-container mx-auto px-gutter py-section">
    <h1 class="font-headline text-headline-lg text-primary mb-2">
      {zoneData.name} &mdash; {businesses.length} servicio{businesses.length !== 1 ? 's' : ''}
    </h1>

    {zoneData.description && (
      <p class="font-sans text-body-lg text-on-surface-variant max-w-2xl mb-8">
        {zoneData.description}
      </p>
    )}

    {businesses.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {businesses.map((biz) => (
          <ServiceCard business={biz} />
        ))}
      </div>
    ) : (
      <div class="text-center py-16 bg-surface-container-low rounded-md border border-outline-card">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="56"
          height="56"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="mx-auto text-on-surface-variant/30 mb-4"
        >
          <circle cx="12" cy="12" r="10"/>
          <path d="M16 16s-1.5-2-4-2-4 2-4 2"/>
          <line x1="9" y1="9" x2="9.01" y2="9"/>
          <line x1="15" y1="9" x2="15.01" y2="9"/>
        </svg>
        <p class="text-body-lg text-on-surface-variant font-sans">
          No hay servicios en esta zona todavía
        </p>
        <p class="text-label-md text-on-surface-variant/60 mt-1">
          Estamos expandiendo el catálogo. ¡Volvé pronto!
        </p>
      </div>
    )}

    <!-- Back to home -->
    <div class="mt-section text-center">
      <a href="/" class="btn-secondary btn-md inline-flex">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="m15 18-6-6 6-6"/>
        </svg>
        Volver al inicio
      </a>
    </div>
  </div>
</BaseLayout>
