---
export const prerender = false;

import { validateSession } from '@/lib/auth';

// Auth guard
const sessionCookie = Astro.cookies.get('session');
if (!sessionCookie?.value) {
  return Astro.redirect('/admin/login', 302);
}

const sessionData = validateSession(sessionCookie.value);
if (!sessionData) {
  return Astro.redirect('/admin/login', 302);
}

const userEmail = sessionData.email;
const error = Astro.url.searchParams.get('error') || '';
const success = Astro.url.searchParams.get('msg') === 'Contraseña+actualizada';

// Redirect to dashboard if password is already changed
if (!sessionData.needsPasswordChange && !success) {
  return Astro.redirect('/admin', 302);
}
---

<!doctype html>
<html lang="es" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Cambiar contraseña — Catálogo Ensenada</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@600;700&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      *, ::before, ::after { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        font-family: 'Inter', sans-serif;
        background-color: #fcf9f2;
        color: #1c1c18;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        padding: 1rem;
      }
    </style>
  </head>
  <body>
    <div class="w-full max-w-md">
      <!-- Brand -->
      <div class="text-center mb-8">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-xl bg-primary mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        </div>
        <h1 class="font-headline font-bold text-headline-md text-primary">Catálogo Ensenada</h1>
        <p class="text-label-md text-on-surface-variant mt-1">Seguridad de la cuenta</p>
      </div>

      <!-- Change Password Card -->
      <div class="bg-white rounded-xl shadow-coastal border border-outline-card p-8">
        {success ? (
          <div class="text-center space-y-4">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-success/10 mb-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#2A9D8F" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            </div>
            <h2 class="font-headline font-semibold text-xl text-primary">¡Contraseña actualizada!</h2>
            <p class="text-body-md text-on-surface-variant">
              Tu cuenta ahora está protegida con una contraseña segura.
            </p>
            <a
              href="/admin"
              class="inline-block w-full py-3 bg-accent hover:bg-accent/90 text-white font-semibold text-label-md rounded-md transition-colors duration-200 shadow-sm text-center"
            >
              Ir al panel
            </a>
          </div>
        ) : (
          <>
            <div class="flex items-center gap-3 mb-6">
              <div class="w-10 h-10 rounded-lg bg-warning/10 flex items-center justify-center shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#b06d00" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
              </div>
              <div>
                <h2 class="font-headline font-semibold text-xl text-primary">Cambiar contraseña</h2>
                <p class="text-label-sm text-on-surface-variant">
                  {userEmail}
                </p>
              </div>
            </div>

            <div class="mb-6 p-3 rounded-md bg-warning/5 border border-warning/20 text-sm">
              <p class="font-medium text-[#b06d00] mb-1">⚠️ Estás usando la contraseña por defecto</p>
              <p class="text-on-surface-variant text-label-sm">Por seguridad, debés cambiarla antes de acceder al panel de administración.</p>
            </div>

            {error && (
              <div class="mb-6 p-3 rounded-md bg-error-container border border-error/30 text-error-on-container text-label-md" role="alert">
                {error}
              </div>
            )}

            <form action="/api/auth/change-password" method="POST" class="space-y-5">
              <div>
                <label for="current_password" class="block text-label-md text-on-surface mb-1.5">
                  Contraseña actual
                </label>
                <input
                  type="password"
                  id="current_password"
                  name="current_password"
                  required
                  autocomplete="current-password"
                  placeholder="••••••••"
                  class="w-full px-4 py-2.5 bg-surface border border-outline-input rounded-md text-body-md focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all placeholder:text-on-surface-variant/50"
                />
              </div>

              <div>
                <label for="new_password" class="block text-label-md text-on-surface mb-1.5">
                  Nueva contraseña
                </label>
                <input
                  type="password"
                  id="new_password"
                  name="new_password"
                  required
                  autocomplete="new-password"
                  minlength="8"
                  placeholder="Mínimo 8 caracteres"
                  class="w-full px-4 py-2.5 bg-surface border border-outline-input rounded-md text-body-md focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all placeholder:text-on-surface-variant/50"
                />
                <p class="mt-1 text-label-sm text-on-surface-variant">
                  Mínimo 8 caracteres, al menos una mayúscula y un número
                </p>
              </div>

              <div>
                <label for="confirm_password" class="block text-label-md text-on-surface mb-1.5">
                  Confirmar contraseña
                </label>
                <input
                  type="password"
                  id="confirm_password"
                  name="confirm_password"
                  required
                  autocomplete="new-password"
                  minlength="8"
                  placeholder="Repetí la contraseña"
                  class="w-full px-4 py-2.5 bg-surface border border-outline-input rounded-md text-body-md focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all placeholder:text-on-surface-variant/50"
                />
              </div>

              <button
                type="submit"
                class="w-full py-3 bg-accent hover:bg-accent/90 text-white font-semibold text-label-md rounded-md transition-colors duration-200 shadow-sm"
              >
                Actualizar contraseña
              </button>
            </form>
          </>
        )}
      </div>
    </div>
  </body>
</html>
