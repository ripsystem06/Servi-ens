---
export const prerender = false;

import AdminLayout from '@/layouts/AdminLayout.astro';
import BannerTable from '@/components/admin/BannerTable.astro';
import { validateSession } from '@/lib/auth';
import { db } from '@/lib/db';
import { banners } from '@/lib/schema';
import { desc } from 'drizzle-orm';
import type { Banner } from '@/lib/banner';

// Query all banners ordered by created_at DESC
const allBanners = db
  .select()
  .from(banners)
  .orderBy(desc(banners.createdAt))
  .all() as Banner[];

// Flash message
const msg = Astro.url.searchParams.get('msg') || '';

// User email from session
const sessionCookie = Astro.cookies.get('session');
const sessionData = sessionCookie?.value ? validateSession(sessionCookie.value) : null;
const userEmail = sessionData?.email || '';
---

<AdminLayout title="Banners" userEmail={userEmail}>
  <!-- Flash message -->
  {msg && (
    <div class="mb-4 p-3 rounded-md bg-success/10 border border-success/30 text-success text-label-md" role="status">
      {msg}
    </div>
  )}

  <!-- Header actions -->
  <div class="flex items-center justify-between mb-6">
    <p class="text-label-md text-on-surface-variant">
      {allBanners.length} {allBanners.length === 1 ? 'banner registrado' : 'banners registrados'}
    </p>
    <a
      href="/admin/banners/nuevo"
      class="inline-flex items-center gap-2 px-4 py-2 bg-accent hover:bg-accent/90 text-white font-semibold text-label-md rounded-md transition-colors"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      Nuevo banner
    </a>
  </div>

  <!-- Table -->
  <div class="bg-white rounded-xl shadow-coastal border border-outline-card">
    {allBanners.length === 0 ? (
      <div class="py-12 text-center">
        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="mx-auto mb-3 text-on-surface-variant/40">
          <path d="m3 11 18-5v12L3 14v-3z"/><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"/>
        </svg>
        <p class="text-label-md text-on-surface-variant mb-2">No hay banners registrados</p>
        <a
          href="/admin/banners/nuevo"
          class="inline-flex items-center gap-2 px-4 py-2 bg-accent hover:bg-accent/90 text-white font-semibold text-label-md rounded-md transition-colors"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Crear primer banner
        </a>
      </div>
    ) : (
      <BannerTable banners={allBanners} />
    )}
  </div>
</AdminLayout>
