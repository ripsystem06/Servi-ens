---
export const prerender = false;

import AdminLayout from '@/layouts/AdminLayout.astro';
import BusinessForm from '@/components/admin/BusinessForm.astro';
import { getCategories, getZones, getBusinesses } from '@/lib/data-loader';
import { validateSession } from '@/lib/auth';
import fs from 'fs';
import path from 'path';

const jsonPath = path.join(process.cwd(), 'src', 'data', 'businesses.json');
const { id } = Astro.params;

const categories = getCategories();
const zones = getZones();
const allBusinesses = getBusinesses();
const businessIndex = allBusinesses.findIndex((b) => b.id === id);
const isNotFound = businessIndex === -1;
const business = isNotFound ? null : allBusinesses[businessIndex];

// User email from session
const sessionCookie = Astro.cookies.get('session');
const sessionData = sessionCookie?.value ? validateSession(sessionCookie.value) : null;
const userEmail = sessionData?.email || '';

let formErrors: Record<string, string> = {};
let formValues: Record<string, string> = {};
let success = false;
let redirectUrl = '';

// Handle POST (only if business exists)
if (Astro.request.method === 'POST' && business) {
  const formData = await Astro.request.formData();
  const action = (formData.get('_action') as string || '').trim();

  // ─── Delete action ───────────────────────────────────────
  if (action === 'delete') {
    try {
      const bizes = JSON.parse(fs.readFileSync(jsonPath, 'utf-8'));
      const filtered = bizes.filter((b: { id: string }) => b.id !== id);
      fs.writeFileSync(jsonPath, JSON.stringify(filtered, null, 2), 'utf-8');
    } catch (err) {
      console.error('[admin] Error deleting business:', err);
    }
    redirectUrl = '/admin/negocios?msg=Negocio+eliminado';
    success = true;
  } else {
    // ─── Update action ──────────────────────────────────────
    const name = (formData.get('name') as string || '').trim();
    const slug = (formData.get('slug') as string || '').trim();
    const cat = (formData.get('category') as string || '').trim();
    const zn = (formData.get('zone') as string || '').trim();
    const description = (formData.get('description') as string || '').trim();
    const phone = (formData.get('phone') as string || '').trim();
    const email = (formData.get('email') as string || '').trim();
    const website = (formData.get('website') as string || '').trim();
    const address = (formData.get('address') as string || '').trim();
    const photosStr = (formData.get('photos') as string || '').trim();
    const servicesStr = (formData.get('services') as string || '').trim();
    const scheduleStr = (formData.get('schedule') as string || '').trim();
    const destacado = formData.get('destacado') === 'true';
    const verified = formData.get('verified') === 'true';

    formValues = { name, slug, category: cat, zone: zn, description, phone, email, website, address, photos: photosStr, services: servicesStr, schedule: scheduleStr, destacado: destacado ? 'true' : '', verified: verified ? 'true' : '' };

    if (!name) formErrors.name = 'El nombre es obligatorio';
    if (!slug) formErrors.slug = 'El slug es obligatorio';
    if (slug && !/^[a-z0-9-]+$/.test(slug)) formErrors.slug = 'El slug solo puede contener letras minúsculas, números y guiones';
    if (!cat) formErrors.category = 'La categoría es obligatoria';
    if (!zn) formErrors.zone = 'La zona es obligatoria';

    if (slug && !formErrors.slug) {
      const others = getBusinesses().filter((b) => b.id !== id);
      if (others.some((b) => b.slug === slug)) {
        formErrors.slug = 'Este slug ya existe';
      }
    }

    if (Object.keys(formErrors).length === 0) {
      const now = new Date().toISOString();
      const photos = photosStr ? photosStr.split('\n').map((s: string) => s.trim()).filter(Boolean) : undefined;
      const services = servicesStr ? servicesStr.split('\n').map((s: string) => s.trim()).filter(Boolean) : [];
      const schedule = scheduleStr ? scheduleStr.split('\n').map((s: string) => s.trim()).filter(Boolean).map((line) => {
        const [day, time] = line.split(':').map((p: string) => p.trim());
        const [open, close] = (time || '').split('-').map((p: string) => p.trim());
        return {
          day: day?.toLowerCase().slice(0, 3) || '',
          open: open || '',
          close: close || '',
          closed: !open || !close,
        };
      }).filter((s) => s.day) : undefined;

      const updatedBusiness = {
        ...business,
        slug,
        name,
        category: cat,
        zone: zn,
        description: description || '',
        phone: phone || '',
        email: email || undefined,
        website: website || undefined,
        address: address || undefined,
        photos: photos && photos.length > 0 ? photos : business.photos,
        schedule: schedule || business.schedule,
        services: services.length > 0 ? services : business.services,
        destacado,
        verified,
        updatedAt: now,
      };

      try {
        const bizes = JSON.parse(fs.readFileSync(jsonPath, 'utf-8')) as { id: string }[];
        const idx = bizes.findIndex((b) => b.id === id);
        if (idx !== -1) {
          bizes[idx] = updatedBusiness;
          fs.writeFileSync(jsonPath, JSON.stringify(bizes, null, 2), 'utf-8');
        }
      } catch (err) {
        console.error('[admin] Error updating business:', err);
      }

      redirectUrl = '/admin/negocios?msg=Negocio+actualizado';
      success = true;
    }
  }
}

if (success && redirectUrl) {
  return Astro.redirect(redirectUrl, 302);
}

// Prepare initial form values for GET (only if business exists)
let initialValues: Record<string, string> = {};
if (business) {
  initialValues = {
    name: business.name,
    slug: business.slug,
    category: business.category,
    zone: business.zone,
    description: business.description,
    phone: business.phone,
    email: business.email || '',
    website: business.website || '',
    address: business.address || '',
    photos: business.photos ? business.photos.join('\n') : '',
    services: business.services ? business.services.join('\n') : '',
    schedule: business.schedule ? business.schedule.map((s) => `${s.day}: ${s.open}-${s.close}`).join('\n') : '',
    destacado: business.destacado ? 'true' : '',
    verified: business.verified ? 'true' : '',
  };
}
---

<AdminLayout title={business ? `Editar: ${business.name}` : 'Negocio no encontrado'} userEmail={userEmail}>
  {isNotFound ? (
    <div class="max-w-lg mx-auto py-16 text-center">
      <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="mx-auto mb-4 text-on-surface-variant/40">
        <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
      </svg>
      <h2 class="font-headline font-semibold text-headline-lg text-on-surface mb-2">Negocio no encontrado</h2>
      <p class="text-label-md text-on-surface-variant mb-6">El negocio que buscás no existe o fue eliminado.</p>
      <a
        href="/admin/negocios"
        class="inline-flex items-center gap-2 px-4 py-2 bg-accent hover:bg-accent/90 text-white font-semibold text-label-md rounded-md transition-colors"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
        Volver a negocios
      </a>
    </div>
  ) : (
    <div class="max-w-3xl">
      <div class="bg-white rounded-xl shadow-coastal border border-outline-card p-8">
        <div class="flex items-center justify-between mb-6">
          <h2 class="font-headline font-semibold text-headline-md text-primary">
            Editar negocio
          </h2>
          <form method="POST" onsubmit="return confirm('¿Estás seguro de eliminar este negocio?')" class="inline">
            <input type="hidden" name="_action" value="delete" />
            <button
              type="submit"
              class="inline-flex items-center gap-2 px-4 py-2 border border-error/30 text-error hover:bg-error-container rounded-md text-label-md transition-colors"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/></svg>
              Eliminar
            </button>
          </form>
        </div>

        {Object.keys(formErrors).length > 0 && (
          <div class="mb-6 p-3 rounded-md bg-error-container border border-error/30 text-error-on-container text-label-md" role="alert">
            Corregí los errores para continuar
          </div>
        )}

        <BusinessForm
          business={business ?? undefined}
          categories={categories.map((c) => ({ slug: c.slug, name: c.name }))}
          zones={zones.map((z) => ({ slug: z.slug, name: z.name }))}
          errors={formErrors}
          values={Object.keys(formValues).length > 0 ? formValues : initialValues}
        />
      </div>
    </div>
  )}
</AdminLayout>
