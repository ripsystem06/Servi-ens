---
export const prerender = false;

import AdminLayout from '@/layouts/AdminLayout.astro';
import { validateSession } from '@/lib/auth';
import {
  getSubmission,
  getCategoryLabel,
  getStatusBadge,
  updateStatus,
} from '@/lib/submission';
import { db } from '@/lib/db';
import { businesses as businessesTable } from '@/lib/schema';

// ── Helper: generate a unique slug from a name ────────────────────
function slugify(text: string): string {
  return text
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');
}

/** Generate the next biz-XXX ID from the database, not from JSON. */
async function generateIdFromDB(): Promise<string> {
  const rows = await db
    .select({ id: businessesTable.id })
    .from(businessesTable);
  const max = rows.reduce((m, r) => {
    const n = parseInt((r.id || '').replace('biz-', ''), 10) || 0;
    return Math.max(m, n);
  }, 0);
  return `biz-${String(max + 1).padStart(3, '0')}`;
}

// ── Auth guard (must run before POST processing) ────────────────────
const sessionCookie = Astro.cookies.get('session');
const sessionData = sessionCookie?.value ? validateSession(sessionCookie.value) : null;
if (!sessionData) return Astro.redirect('/admin/login', 302);

const { id } = Astro.params;
const submissionId = parseInt(id || '0', 10);

if (isNaN(submissionId)) {
  return Astro.redirect('/admin/solicitudes?msg=ID+inválido', 302);
}

const submission = await getSubmission(submissionId);

if (!submission) {
  return Astro.redirect('/admin/solicitudes?msg=Solicitud+no+encontrada', 302);
}

// ── Handle POST actions ──────────────────────────────────────────────
let actionMsg = '';
if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const action = (formData.get('_action') as string || '').trim();
  const notes = (formData.get('admin_notes') as string || '').trim();

  if (action === 'approve') {
    // ── Generate ID from the database (single source of truth) ────
    const newId = await generateIdFromDB();
    const newSlug = slugify(submission.name) + '-' + Date.now().toString(36);
    const servicesList = submission.services
      ? submission.services.split(',').map((s: string) => s.trim()).filter(Boolean)
      : [];
    const now = new Date().toISOString();

    // ── Insert into PostgreSQL FIRST ──────────────────────────────
    try {
      await db.insert(businessesTable).values({
        id: newId,
        slug: newSlug,
        name: submission.name,
        category: submission.category,
        zone: submission.zone,
        description: submission.description,
        phone: submission.phone,
        email: submission.email || '',
        website: submission.website || null,
        address: submission.address || '',
        photos: submission.photoUrl ? [submission.photoUrl] : [],
        services: servicesList,
        verified: true,
        destacado: false,
        experience: null,
        certifications: [],
        availability: null,
        quoteMethod: null,
        tags: [],
        schedule: [],
      });

      // ── Link business to submission ─────────────────────────────
      await updateStatus(submissionId, 'approved', notes || null, newId);

      actionMsg = 'Solicitud aprobada y servicio creado en el catálogo';
    } catch (dbErr: any) {
      console.error('[admin] Error al crear servicio en la DB:', dbErr);
      actionMsg = 'ERROR DB: ' + (dbErr?.message || String(dbErr)).substring(0, 150);
    }
  } else if (action === 'reject') {
    await updateStatus(submissionId, 'rejected', notes || null);
    actionMsg = 'Solicitud rechazada';
  } else if (action === 'pending') {
    await updateStatus(submissionId, 'pending', notes || null);
    actionMsg = 'Solicitud marcada como pendiente';
  }

  if (actionMsg) {
    return Astro.redirect(`/admin/solicitudes?msg=${encodeURIComponent(actionMsg)}`, 302);
  }
}

const badge = getStatusBadge(submission.status);
---

<AdminLayout title={`Solicitud: ${submission.name}`}>
  <!-- Back link -->
  <a
    href="/admin/solicitudes"
    class="inline-flex items-center gap-1 text-label-md text-on-surface-variant hover:text-primary transition-colors mb-6"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="m15 18-6-6 6-6"/>
    </svg>
    Volver a solicitudes
  </a>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Main card: details -->
    <div class="lg:col-span-2 space-y-6">
      <div class="bg-white rounded-xl shadow-coastal border border-outline-card p-6">
        <div class="flex items-start justify-between mb-4">
          <div>
            <h1 class="font-headline text-headline-md text-on-surface mb-1">{submission.name}</h1>
            <span class={`inline-flex items-center gap-1 px-2 py-0.5 rounded-full ${badge.bg} ${badge.text} text-label-sm font-medium`}>
              {badge.label}
            </span>
          </div>
        </div>

        <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-6">
          <div>
            <dt class="text-label-sm font-semibold text-on-surface-variant mb-0.5">Categoría</dt>
            <dd class="text-body-md text-on-surface">{getCategoryLabel(submission.category)}</dd>
          </div>
          <div>
            <dt class="text-label-sm font-semibold text-on-surface-variant mb-0.5">Zona</dt>
            <dd class="text-body-md text-on-surface">{getCategoryLabel(submission.zone)}</dd>
          </div>
          <div>
            <dt class="text-label-sm font-semibold text-on-surface-variant mb-0.5">Teléfono</dt>
            <dd class="text-body-md text-on-surface">
              <a href={`tel:${submission.phone}`} class="hover:text-primary transition-colors">
                {submission.phone}
              </a>
            </dd>
          </div>
          <div>
            <dt class="text-label-sm font-semibold text-on-surface-variant mb-0.5">Email</dt>
            <dd class="text-body-md text-on-surface">
              {submission.email ? (
                <a href={`mailto:${submission.email}`} class="hover:text-primary transition-colors">
                  {submission.email}
                </a>
              ) : (
                <span class="text-on-surface-variant/60">No proporcionado</span>
              )}
            </dd>
          </div>
          {submission.services && (
            <div class="sm:col-span-2">
              <dt class="text-label-sm font-semibold text-on-surface-variant mb-0.5">Servicios que ofrece</dt>
              <dd class="text-body-md text-on-surface">{submission.services}</dd>
            </div>
          )}
          <div class="sm:col-span-2">
            <dt class="text-label-sm font-semibold text-on-surface-variant mb-0.5">Descripción</dt>
            <dd class="text-body-md text-on-surface bg-surface-container-low rounded-md p-4 mt-1 whitespace-pre-wrap">
              {submission.description}
            </dd>
          </div>
          <div>
            <dt class="text-label-sm font-semibold text-on-surface-variant mb-0.5">Fecha de solicitud</dt>
            <dd class="text-body-md text-on-surface">
              {submission.createdAt
                ? new Date(submission.createdAt + 'Z').toLocaleDateString('es-MX', {
                    day: 'numeric',
                    month: 'long',
                    year: 'numeric',
                    hour: '2-digit',
                    minute: '2-digit',
                  })
                : '-'}
            </dd>
          </div>
        </dl>
      </div>

      <!-- Admin notes -->
      {submission.adminNotes && (
        <div class="bg-surface-container-low rounded-xl border border-outline-card p-6">
          <h2 class="font-headline text-headline-sm text-on-surface mb-2">Notas del administrador</h2>
          <p class="text-body-md text-on-surface-variant whitespace-pre-wrap">{submission.adminNotes}</p>
        </div>
      )}
    </div>

    <!-- Sidebar: actions -->
    <div class="space-y-4">
      <div class="bg-white rounded-xl shadow-coastal border border-outline-card p-6">
        <h2 class="font-headline text-headline-sm text-on-surface mb-4">Acciones</h2>

        <form method="POST" class="space-y-3">
          <!-- Admin notes -->
          <div>
            <label for="admin_notes" class="block text-label-sm font-semibold text-on-surface-variant mb-1">
              Notas internas
            </label>
            <textarea
              id="admin_notes"
              name="admin_notes"
              rows="3"
              placeholder="Opcional: agregá notas sobre esta solicitud..."
              class="w-full bg-surface-container-low border border-outline-variant rounded-lg px-3 py-2 text-body-md focus:ring-2 focus:ring-primary focus:border-transparent outline-none transition-all resize-y text-sm"
            >{submission.adminNotes || ''}</textarea>
          </div>

          <div class="space-y-2 pt-2">
            {submission.status === 'pending' && (
              <>
                <button
                  type="submit"
                  name="_action"
                  value="approve"
                  class="w-full flex items-center justify-center gap-2 px-4 py-2.5 bg-success hover:bg-success/90 text-white font-semibold text-label-md rounded-lg transition-colors"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/>
                  </svg>
                  Aprobar solicitud
                </button>
                <button
                  type="submit"
                  name="_action"
                  value="reject"
                  class="w-full flex items-center justify-center gap-2 px-4 py-2.5 bg-error hover:bg-error/90 text-white font-semibold text-label-md rounded-lg transition-colors"
                >
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/>
                  </svg>
                  Rechazar solicitud
                </button>
              </>
            )}

            {submission.status === 'approved' && (
              <>
                <div class="p-3 rounded-md bg-success/10 border border-success/30 text-success text-label-sm mb-3">
                  Esta solicitud ya fue aprobada.
                </div>
                <button
                  type="submit"
                  name="_action"
                  value="reject"
                  class="w-full flex items-center justify-center gap-2 px-4 py-2.5 bg-error hover:bg-error/90 text-white font-semibold text-label-md rounded-lg transition-colors"
                >
                  Cambiar a rechazado
                </button>
                <button
                  type="submit"
                  name="_action"
                  value="pending"
                  class="w-full flex items-center justify-center gap-2 px-4 py-2.5 border border-outline-card hover:bg-surface-container-low text-on-surface font-semibold text-label-md rounded-lg transition-colors"
                >
                  Volver a pendiente
                </button>
              </>
            )}

            {submission.status === 'rejected' && (
              <>
                <div class="p-3 rounded-md bg-error/10 border border-error/30 text-error text-label-sm mb-3">
                  Esta solicitud fue rechazada.
                </div>
                <button
                  type="submit"
                  name="_action"
                  value="approve"
                  class="w-full flex items-center justify-center gap-2 px-4 py-2.5 bg-success hover:bg-success/90 text-white font-semibold text-label-md rounded-lg transition-colors"
                >
                  Cambiar a aprobado
                </button>
                <button
                  type="submit"
                  name="_action"
                  value="pending"
                  class="w-full flex items-center justify-center gap-2 px-4 py-2.5 border border-outline-card hover:bg-surface-container-low text-on-surface font-semibold text-label-md rounded-lg transition-colors"
                >
                  Volver a pendiente
                </button>
              </>
            )}
          </div>
        </form>
      </div>

      <!-- Info card -->
      <div class="bg-surface-container-low rounded-xl border border-outline-card p-6">
        <h2 class="font-headline text-headline-sm text-on-surface mb-2">Información</h2>
        <p class="text-label-md text-on-surface-variant">
          Las solicitudes aprobadas pueden ser publicadas en el catálogo. Las
          rechazadas quedan archivadas. Podés cambiar el estado en cualquier
          momento.
        </p>
      </div>
    </div>
  </div>
</AdminLayout>
