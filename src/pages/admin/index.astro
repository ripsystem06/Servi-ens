---
export const prerender = false;

import AdminLayout from '@/layouts/AdminLayout.astro';
import StatCard from '@/components/admin/StatCard.astro';
import { getBusinesses } from '@/lib/data-loader';
import { validateSession } from '@/lib/auth';
import { countPending } from '@/lib/submission';
import { db } from '@/lib/db';
import { banners } from '@/lib/schema';
import { sql } from 'drizzle-orm';

const businesses = getBusinesses();
const totalNegocios = businesses.length;
const pendientes = businesses.filter((b) => !b.verified).length;
const registrosPendientes = countPending();

// Active banners count (start_date <= now <= end_date)
const now = new Date().toISOString().split('T')[0];
const activeBannersResult = db
  .select({ count: sql<number>`count(*)` })
  .from(banners)
  .where(
    sql`${banners.startDate} <= ${now} AND ${banners.endDate} >= ${now}`
  )
  .all();
const bannersActivos = activeBannersResult[0]?.count ?? 0;

// User email from session
const sessionCookie = Astro.cookies.get('session');
const sessionData = sessionCookie?.value ? validateSession(sessionCookie.value) : null;
const userEmail = sessionData?.email || '';
---

<AdminLayout title="Dashboard" userEmail={userEmail}>
  <!-- Stats Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-6 mb-8">
    <StatCard
      title="Total Servicios"
      value={String(totalNegocios)}
      icon="building-2"
    />
    <StatCard
      title="Pendientes"
      value={String(pendientes)}
      icon="clock"
      trend={pendientes > 0 ? 'down' : undefined}
      trendLabel="por verificar"
    />
    <StatCard
      title="Solicitudes"
      value={String(registrosPendientes)}
      icon="clipboard-list"
      trend={registrosPendientes > 0 ? 'up' : undefined}
      trendLabel="por revisar"
      href="/admin/solicitudes"
    />
    <StatCard
      title="Banners Activos"
      value={String(bannersActivos)}
      icon="megaphone"
    />
  </div>

  <!-- Engagement Chart Area (placeholder) -->
  <div class="bg-white rounded-xl shadow-coastal border border-outline-card p-6">
    <h2 class="font-headline font-semibold text-headline-md text-on-surface mb-4">Engagement</h2>
    <div class="flex items-center justify-center h-48 bg-surface-container-low rounded-lg border border-outline-card">
      <div class="text-center">
        <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="mx-auto mb-3 text-on-surface-variant/40">
          <path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/>
        </svg>
        <p class="text-label-md text-on-surface-variant">Sin datos de engagement</p>
        <p class="text-label-sm text-on-surface-variant/60 mt-1">Las estadísticas aparecerán aquí cuando haya actividad</p>
      </div>
    </div>
  </div>
</AdminLayout>
