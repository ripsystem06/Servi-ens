---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CategorySidebar from '@/components/CategorySidebar.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import BannerSlot from '@/components/BannerSlot.astro';
import HeroBanner from '@/components/HeroBanner.astro';
import {
  getCategories,
  getCategoryBySlug,
  filterByCategory,
} from '@/lib/data-loader';

export async function getStaticPaths() {
  const categories = getCategories();
  return categories.map((cat) => ({
    params: { category: cat.slug },
  }));
}

const { category } = Astro.params;
const cat = getCategoryBySlug(category);

// Invalid category slug → 404
if (!cat) {
  return Astro.redirect('/404');
}

const businesses = filterByCategory(category);
const pageTitle = `${cat.name} — Catálogo Ensenada`;
---

<BaseLayout title={pageTitle}>
  <div class="max-w-container mx-auto px-gutter py-section">
    <!-- Wide Advertising Banner -->
    <div class="mb-6 relative">
      <HeroBanner />
      <span class="absolute bottom-2 right-3 text-label-sm text-muted/50">Espacio publicitario</span>
    </div>

    <!-- Directory Disclaimer -->
    <p class="text-center text-label-sm text-muted/60 mb-8">
      📋 Directorio de servicios — contactá directamente a cada profesional. No gestionamos contrataciones.
    </p>

    <div class="grid grid-cols-12 gap-6 lg:gap-20">
      <!-- Sidebar -->
      <aside class="col-span-12 lg:col-span-3 space-y-6">
        <CategorySidebar activeSlug={category} />

        <BannerSlot slot="sidebar-left" category={category} />
      </aside>

      <!-- Main Content -->
      <section class="col-span-12 lg:col-span-9 space-y-6">
        {businesses.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
            {businesses.map((biz) => (
              <ServiceCard business={biz} />
            ))}
          </div>
        ) : (
          <div class="text-center py-16 bg-surface-container-low rounded-md border border-outline-card">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="56"
              height="56"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="mx-auto text-on-surface-variant/30 mb-4"
            >
              <circle cx="12" cy="12" r="10"/>
              <path d="M16 16s-1.5-2-4-2-4 2-4 2"/>
              <line x1="9" y1="9" x2="9.01" y2="9"/>
              <line x1="15" y1="9" x2="15.01" y2="9"/>
            </svg>
            <p class="text-body-lg text-on-surface-variant font-sans">
              No hay servicios en esta categoría todavía
            </p>
            <p class="text-label-md text-on-surface-variant/60 mt-1">
              Estamos trabajando para agregar más servicios. ¡Volvé pronto!
            </p>
          </div>
        )}
      </section>
    </div>
  </div>
</BaseLayout>
