---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Página no encontrada — Catálogo Ensenada">
  <div class="max-w-container mx-auto px-gutter py-section">
    <div class="text-center py-20">
      <h1 class="font-headline text-headline-xl text-primary mb-4">404</h1>
      <p class="font-sans text-body-lg text-on-surface-variant mb-8 max-w-md mx-auto">
        La página que estás buscando no existe o fue movida.
      </p>
      <a
        href="/"
        class="btn-primary btn-lg inline-flex"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="m15 18-6-6 6-6"/>
        </svg>
        Volver al inicio
      </a>
    </div>
  </div>
</BaseLayout>
