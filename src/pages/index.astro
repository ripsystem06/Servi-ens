---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroBanner from '@/components/HeroBanner.astro';
import CategorySidebar from '@/components/CategorySidebar.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import { getPopularBusinesses } from '@/lib/data-loader';

const popular = getPopularBusinesses();
const pageTitle = 'Catálogo Ensenada — Directorio de Servicios Locales';

const bannersVerticales = [
  { src: "/banners/verticales/1.png", alt: "Publicidad 1", link: "#" },
  { src: "/banners/verticales/2.png", alt: "Publicidad 2", link: "#" },
  { src: "/banners/verticales/3.png", alt: "Publicidad 3", link: "#" },
  { src: "/banners/verticales/4.png", alt: "Publicidad 4", link: "#" },
];
---

<BaseLayout title={pageTitle}>
  <!-- Hero Banner Publicitario -->
  <section class="max-w-container mx-auto px-gutter py-section">
    <HeroBanner />
  </section>

  <div class="max-w-container mx-auto px-gutter py-section">
    <div class="grid grid-cols-12 gap-6 lg:gap-20">
      <!-- Left Sidebar -->
      <aside class="col-span-12 lg:col-span-3 space-y-6">
        <CategorySidebar />

        <!-- Banner Vertical -->
        <div class="space-y-3">
          <p class="font-sans text-label-sm text-on-surface-variant/50 uppercase tracking-widest text-center">Espacio Publicitario</p>
          <a href={bannersVerticales[0].link} class="block rounded-xl overflow-hidden shadow-md hover:shadow-lg transition-shadow">
            <img src={bannersVerticales[0].src} alt={bannersVerticales[0].alt} class="w-full h-auto object-cover" />
          </a>
        </div>
      </aside>

      <!-- Center Content -->
      <section class="col-span-12 lg:col-span-6 space-y-section">
        <!-- Popular Services -->
        <div>
          <div class="flex items-center justify-between mb-6">
            <h2 class="font-headline text-headline-lg text-primary">
              Servicios Populares
            </h2>
            <a
              href="/buscar"
              class="text-secondary font-bold flex items-center gap-1 hover:underline font-sans text-label-md"
            >
              Ver todos
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="m9 18 6-6-6-6"/>
              </svg>
            </a>
          </div>

          {popular.length > 0 ? (
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              {popular.slice(0, 6).map((biz) => (
                <ServiceCard business={biz} />
              ))}
            </div>
          ) : (
            <div class="text-center py-16 bg-surface-container-low rounded-md border border-outline-card">
              <p class="text-body-lg text-on-surface-variant">Próximamente</p>
              <p class="text-label-md text-on-surface-variant/60 mt-1">
                Estamos preparando el catálogo de servicios. ¡Volvé pronto!
              </p>
            </div>
          )}
        </div>

        <!-- CTA: ¿Ofrecés un servicio? -->
        <section class="bg-primary-container rounded-md p-8 text-white text-center">
          <h2 class="font-headline text-headline-md mb-3">
            ¿Ofrecés un servicio en Ensenada?
          </h2>
          <p class="font-sans text-body-md text-white/80 max-w-lg mx-auto mb-6">
            Sumá tu servicio al catálogo más completo de la región. Llegá a más
            clientes locales y turistas que buscan lo que ofrecés.
          </p>
          <a
            href="mailto:contacto@catalogoensenada.com"
            class="inline-flex items-center gap-2 bg-white text-primary font-bold py-3 px-8 rounded-lg hover:opacity-90 transition-opacity"
          >
            Contactanos
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
            </svg>
          </a>
        </section>
      </section>

      <!-- Right Sidebar -->
      <aside class="col-span-12 lg:col-span-3 space-y-6">
        <p class="font-sans text-label-sm text-on-surface-variant/50 uppercase tracking-widest text-center">Espacio Publicitario</p>
        {bannersVerticales.slice(1).map((banner) => (
          <a href={banner.link} class="block rounded-xl overflow-hidden shadow-md hover:shadow-lg transition-shadow">
            <img src={banner.src} alt={banner.alt} class="w-full h-auto object-cover" />
          </a>
        ))}
      </aside>
    </div>
  </div>
</BaseLayout>
