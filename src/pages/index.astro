---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroCarousel from '@/components/islands/HeroCarousel.tsx';
import CategorySidebar from '@/components/CategorySidebar.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import BannerSlot from '@/components/BannerSlot.astro';
import {
  getFeaturedBusinesses,
  getPopularBusinesses,
} from '@/lib/data-loader';

const featured = getFeaturedBusinesses();
const popular = getPopularBusinesses();

const pageTitle = 'Catálogo Ensenada — Directorio de Servicios Locales';
---

<BaseLayout title={pageTitle}>
  <!-- Hero Area -->
  {featured.length > 0 && (
    <section class="max-w-container mx-auto px-gutter py-section">
      <HeroCarousel
        businesses={featured}
        client:load
      />
    </section>
  )}

  <div class="max-w-container mx-auto px-gutter py-section">
    <div class="grid grid-cols-12 gap-gutter">
      <!-- Left Sidebar -->
      <aside class="col-span-12 lg:col-span-3 space-y-6">
        <CategorySidebar />

        <!-- Banner Sidebar Left -->
        <BannerSlot slot="sidebar-left" />
      </aside>

      <!-- Center Content -->
      <section class="col-span-12 lg:col-span-6 space-y-section">
        <!-- Popular Services -->
        <div>
          <div class="flex items-center justify-between mb-6">
            <h2 class="font-headline text-headline-lg text-primary">
              Servicios Populares
            </h2>
            <a
              href="/buscar"
              class="text-secondary font-bold flex items-center gap-1 hover:underline font-sans text-label-md"
            >
              Ver todos
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="m9 18 6-6-6-6"/>
              </svg>
            </a>
          </div>

          {popular.length > 0 ? (
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              {popular.slice(0, 6).map((biz) => (
                <ServiceCard business={biz} />
              ))}
            </div>
          ) : (
            <div class="text-center py-16 bg-surface-container-low rounded-md border border-outline-card">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="48"
                height="48"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="mx-auto text-on-surface-variant/40 mb-4"
              >
                <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/>
                <polyline points="14 2 14 8 20 8"/>
              </svg>
              <p class="text-body-lg text-on-surface-variant">Próximamente</p>
              <p class="text-label-md text-on-surface-variant/60 mt-1">
                Estamos preparando el catálogo de servicios. ¡Volvé pronto!
              </p>
            </div>
          )}
        </div>

        <!-- CTA: ¿Eres dueño de un negocio? -->
        <section class="bg-primary-container rounded-md p-8 text-on-primary-container text-center">
          <h2 class="font-headline text-headline-md mb-3">
            ¿Tenés un negocio en Ensenada?
          </h2>
          <p class="font-sans text-body-md opacity-80 max-w-lg mx-auto mb-6">
            Sumá tu servicio al catálogo más completo de la región. Llegá a más
            clientes locales y turistas que buscan lo que ofrecés.
          </p>
          <a
            href="mailto:contacto@catalogoensenada.com"
            class="inline-flex items-center gap-2 bg-on-primary-container text-primary-container font-bold py-3 px-8 rounded-lg hover:opacity-90 transition-opacity"
          >
            Contactanos
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
            </svg>
          </a>
        </section>
      </section>

      <!-- Right Sidebar -->
      <aside class="col-span-12 lg:col-span-3 space-y-6">
        <!-- Banner Sidebar Right -->
        <BannerSlot slot="sidebar-right" />

        <!-- Local Partners -->
        <div class="bg-primary-container p-4 rounded-md text-on-primary-container">
          <h4 class="font-sans font-bold mb-3 inline-flex items-center gap-2 text-label-md">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
            Aliados Locales
          </h4>
          <div class="flex flex-wrap gap-2">
            <span class="bg-on-primary-container/10 border border-on-primary-container/20 px-2 py-1 rounded text-[11px] font-bold">
              ENSENADA
            </span>
            <span class="bg-on-primary-container/10 border border-on-primary-container/20 px-2 py-1 rounded text-[11px] font-bold">
              VALLE
            </span>
            <span class="bg-on-primary-container/10 border border-on-primary-container/20 px-2 py-1 rounded text-[11px] font-bold">
              BAJA
            </span>
          </div>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
