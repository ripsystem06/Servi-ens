---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroNew from '@/components/HeroNew.astro';
import HeroBanner from '@/components/HeroBanner.astro';
import CategoriesGrid from '@/components/CategoriesGrid.astro';
import CTASection from '@/components/CTASection.astro';
---

<BaseLayout>
  <HeroNew />
  <section class="px-gutter py-8 relative">
    <HeroBanner />
    <span class="absolute bottom-2 right-6 text-label-sm text-muted/50">Espacio publicitario</span>
  </section>
  <CategoriesGrid />
  <CTASection />
</BaseLayout>
