---
import BaseLayout from '@/layouts/BaseLayout.astro';
import HeroNew from '@/components/HeroNew.astro';
import HeroBanner from '@/components/HeroBanner.astro';
import CategoriesGrid from '@/components/CategoriesGrid.astro';
import CTASection from '@/components/CTASection.astro';
import ScrollReveal from '@/components/ScrollReveal.astro';
// Preload ALL heavy modules so admin and forms are fast on first visit
import '@/lib/auth';
import '@/lib/submission';
import '@/lib/db';
import '@/lib/data-loader';
import '@/lib/csrf';
---

<BaseLayout>
  <HeroNew />
  <section class="px-gutter py-8 relative scroll-reveal">
    <HeroBanner />
    <span class="absolute bottom-2 right-6 text-label-sm text-muted/50">Espacio publicitario</span>
  </section>
  <div class="scroll-reveal">
    <CategoriesGrid />
  </div>
  <div class="scroll-reveal">
    <CTASection />
  </div>
  <ScrollReveal />
</BaseLayout>
